{
  "name": "stem",
  "version": "0.16.0",
  "description": "Modal terminal editor",
  "languages": {
    "tier1": [
      "zig",
      "python",
      "javascript",
      "typescript",
      "rust",
      "go",
      "c",
      "cpp",
      "java",
      "ruby",
      "csharp"
    ],
    "tier2": ["php", "swift", "kotlin", "lua", "dart", "elixir", "haskell"]
  },
  "features": {
    "treeSitter": true,
    "lspSupport": true,
    "incrementalParsing": true
  },
  "limits": {
    "maxFileSizeMb": 50,
    "parserTimeoutMs": 250,
    "tabWidth": 4
  },
  "authors": [
    { "name": "Ola", "role": "creator" }
  ]
}
