{
  "name": "git",
  "version": "0.6.0",
  "description": "Git integration. Runs git subcommands and tracks the active branch in the status bar.",
  "runtime": "wasm",
  "entry": "git-wasm.wasm",
  "permissions": {
    "spawn": ["git"],
    "events": ["buffer.switched", "buffer.changed", "file.saved"]
  },
  "commands": [
    {"id": "git.status", "title": "[Git] Status", "description": "Show repository status (git status --porcelain)"},
    {"id": "git.diff", "title": "[Git] Diff", "description": "Show unstaged changes (git diff)"},
    {"id": "git.diff_staged", "title": "[Git] Diff Staged", "description": "Show staged changes (git diff --staged)"}
  ]
}
